// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum StampType {
  EARN
  REDEEM
  ADJUSTMENT
}

enum RewardStatus {
  ACTIVE
  INACTIVE
}

enum RedemptionStatus {
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  firstName String?
  lastName  String?

  memberships BusinessMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// BUSINESS
// ─────────────────────────────────────────────

model Business {
  id   String @id @default(cuid())
  name String
  slug String @unique

  email   String?
  phone   String?
  address String?

  members BusinessMember[]

  program LoyaltyProgram?

  customers Customer[]

  stamps StampLedger[]

  rewards LoyaltyReward[]

  redemptions RewardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// BUSINESS MEMBERS
// ─────────────────────────────────────────────

model BusinessMember {
  id String @id @default(cuid())

  userId     String
  businessId String

  role UserRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, businessId])
}

// ─────────────────────────────────────────────
// LOYALTY PROGRAM
// ─────────────────────────────────────────────

model LoyaltyProgram {
  id String @id @default(cuid())

  businessId String @unique

  name           String
  stampsRequired Int

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customers Customer[]
  rewards   LoyaltyReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────

model Customer {
  id String @id @default(cuid())

  businessId String
  programId  String

  name  String?
  phone String
  email String?

  stampBalance Int @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  stamps StampLedger[]

  redemptions RewardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, phone])
}

// ─────────────────────────────────────────────
// STAMP LEDGER
// ─────────────────────────────────────────────

model StampLedger {
  id String @id @default(cuid())

  businessId String
  customerId String

  amount Int
  type   StampType

  description String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
}

// ─────────────────────────────────────────────
// REWARD
// ─────────────────────────────────────────────

model LoyaltyReward {
  id String @id @default(cuid())

  businessId String
  programId  String

  name        String
  description String?

  stampsRequired Int

  status RewardStatus @default(ACTIVE)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  redemptions RewardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// REDEMPTION
// ─────────────────────────────────────────────

model RewardRedemption {
  id String @id @default(cuid())

  businessId String
  customerId String
  rewardId   String

  stampsUsed Int

  status RedemptionStatus @default(COMPLETED)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  reward LoyaltyReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
}
